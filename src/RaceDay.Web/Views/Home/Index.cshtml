@model JsonElement[]
@{Layout="_Layout";}<section class="hero mb-4"><p class="text-uppercase mb-1">Find your finish line</p><h1>Race beyond ordinary.</h1><p>Browse running, walking and cycling events built for every pace.</p></section><form class="row g-2 mb-4"><div class="col-md-5"><input class="form-control" name="location" placeholder="Filter by location" /></div><div class="col-md-4"><select class="form-select" name="type"><option value="">All event types</option><option value="run">Run</option><option value="walk">Walk</option><option value="cycle">Cycle</option></select></div><div class="col-md-3"><button class="btn btn-race w-100">Find events</button></div></form><div class="row g-4">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><article class="card h-100 event-card">@if(e.TryGetProperty("bannerImageUrl",out var image)&&image.ValueKind==JsonValueKind.String){<img class="card-img-top event-image" src="@image.GetString()" alt="Event banner"/>}<div class="card-body"><span class="badge text-bg-dark">@e.GetProperty("eventType").GetString()</span><h2 class="h4 mt-2">@e.GetProperty("eventName").GetString()</h2><p class="small">@e.GetProperty("eventDate").GetString() · @e.GetProperty("location").GetString()</p><a class="btn btn-outline-dark" asp-action="Details" asp-route-id="@e.GetProperty("eventId").GetInt32()">View event</a></div></article></div>}@if(!Model.Any()){<p>No upcoming events match your filters.</p>}</div>
