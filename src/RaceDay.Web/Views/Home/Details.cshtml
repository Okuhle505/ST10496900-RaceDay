@model JsonElement
@{Layout="_Layout";var id=Model.GetProperty("eventId").GetInt32();}<div class="row"><div class="col-lg-8">@if(Model.TryGetProperty("bannerImageUrl",out var img)&&img.ValueKind==JsonValueKind.String){<img class="detail-image mb-3" src="@img.GetString()" alt="Event banner"/>}<h1>@Model.GetProperty("eventName").GetString()</h1><p class="lead">@Model.GetProperty("description").GetString()</p><p><strong>@Model.GetProperty("eventDate").GetString()</strong> · @Model.GetProperty("location").GetString() · @Model.GetProperty("distance").GetDecimal() km</p></div><div class="col-lg-4"><div class="card p-3"><h2 class="h4">Choose a category</h2>@foreach(var c in Model.GetProperty("categories").EnumerateArray()){<div class="border-bottom py-2"><strong>@c.GetProperty("categoryName").GetString()</strong><br/><small>@c.GetProperty("distance").GetDecimal() km · ages @c.GetProperty("minAge").GetInt32()-@c.GetProperty("maxAge").GetInt32() · R @c.GetProperty("entryFee").GetDecimal()</small><form asp-controller="Participant" asp-action="Enrol" method="post" class="mt-2"><input type="hidden" name="categoryId" value="@c.GetProperty("categoryId").GetInt32()"/><input type="hidden" name="eventId" value="@id"/><button class="btn btn-race btn-sm">Enrol now</button></form></div>}</div></div></div>
