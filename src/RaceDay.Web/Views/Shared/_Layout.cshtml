@{ var role = Context.Session.GetString("role"); }
<!doctype html><html><head><title>RaceDay</title><link rel="stylesheet" href="~/css/site.css" /></head><body><nav><a asp-controller="Home" asp-action="Index">RaceDay</a>@if (role == "Participant") { <text> | </text><a asp-controller="Participant" asp-action="Enrollments">My enrolments</a><text> | </text><a asp-controller="Participant" asp-action="Results">My results</a> }@if (role == "Organiser") { <text> | </text><a asp-controller="Organiser" asp-action="Dashboard">Organiser dashboard</a> }@if (string.IsNullOrWhiteSpace(role)) { <text> | </text><a asp-controller="Account" asp-action="Login">Login</a> } else { <text> | </text><a asp-controller="Account" asp-action="Logout">Logout</a> }</nav><main>@RenderBody()</main></body></html>
