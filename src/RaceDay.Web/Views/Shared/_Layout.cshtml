@{ var role = Context.Session.GetString("role"); }
<!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1" /><title>RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="~/css/site.css" /></head><body><nav class="navbar navbar-expand-lg navbar-dark race-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">RACEDAY</a><div class="navbar-nav ms-auto">@if(role=="Participant"){<a class="nav-link" asp-controller="Participant" asp-action="Enrollments">My enrolments</a><a class="nav-link" asp-controller="Participant" asp-action="Results">My results</a><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a>}@if(role=="Organiser"){<a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage events</a>}@if(string.IsNullOrWhiteSpace(role)){<a class="nav-link" asp-controller="Account" asp-action="Login">Login</a><a class="btn btn-race ms-lg-2" asp-controller="Account" asp-action="Register">Join RaceDay</a>}else{<a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>}</div></div></nav><main class="container py-4">@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-danger">@err</div>}@RenderBody()</main></body></html>
