@model ProfileViewModel
@{Layout="_Layout";}<h1>My profile</h1><form method="post" enctype="multipart/form-data" class="row g-3"><div class="col-md-4">@if(!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl)){<img class="profile-image" src="@Model.ProfilePictureUrl" alt="Profile picture"/>}<input class="form-control mt-2" asp-for="Picture" type="file" accept="image/*"/></div><div class="col-md-8"><div class="row g-2"><div class="col-md-6"><label>First name</label><input class="form-control" asp-for="FirstName"/></div><div class="col-md-6"><label>Last name</label><input class="form-control" asp-for="LastName"/></div><div class="col-md-6"><label>Date of birth</label><input class="form-control" asp-for="DateOfBirth" type="date"/></div><div class="col-md-6"><label>Gender</label><input class="form-control" asp-for="Gender"/></div><div class="col-12"><label>Emergency contact</label><input class="form-control" asp-for="EmergencyContact"/></div></div><button class="btn btn-race mt-3">Save profile</button></div></form>
