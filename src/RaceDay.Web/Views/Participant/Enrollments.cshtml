@model JsonElement[]
@{Layout="_Layout";}<h1>My enrolments</h1><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Category</th><th>Status</th><th>Payment</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.GetProperty("category").GetProperty("event").GetProperty("eventName").GetString()</td><td>@x.GetProperty("category").GetProperty("categoryName").GetString()</td><td><span class="badge @(x.GetProperty("status").GetString()=="Active"?"text-bg-success":"text-bg-secondary")">@x.GetProperty("status").GetString()</span></td><td><span class="badge text-bg-warning">@x.GetProperty("paymentStatus").GetString()</span></td></tr>}</tbody></table></div>
