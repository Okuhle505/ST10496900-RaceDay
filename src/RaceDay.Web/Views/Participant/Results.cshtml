@model JsonElement[]
@{Layout="_Layout";}<h1>My results</h1><div class="row">@foreach(var x in Model){<div class="col-md-6"><div class="card p-3 mb-3"><h2 class="h5">@x.GetProperty("enrollment").GetProperty("category").GetProperty("event").GetProperty("eventName").GetString()</h2><p>@x.GetProperty("enrollment").GetProperty("category").GetProperty("event").GetProperty("eventDate").GetString() · @x.GetProperty("enrollment").GetProperty("category").GetProperty("categoryName").GetString()</p><strong>@x.GetProperty("finishTime").GetString() · @x.GetProperty("position").GetInt32()th place</strong></div></div>}@if(!Model.Any()){<p>No published results yet.</p>}</div>
