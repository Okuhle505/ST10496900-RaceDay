@model EventViewModel
@{Layout="_Layout";var edit=Model.EventId>0;}<h1>@(edit?"Edit event":"Create event")</h1><form method="post" enctype="multipart/form-data" class="row g-3"><input asp-for="EventId" type="hidden"/><input asp-for="BannerImageUrl" type="hidden"/><div class="col-md-6"><label>Name</label><input class="form-control" asp-for="EventName"/></div><div class="col-md-3"><label>Date</label><input class="form-control" asp-for="EventDate" type="date"/></div><div class="col-md-3"><label>Type</label><select class="form-select" asp-for="EventType"><option value="run">Run</option><option value="walk">Walk</option><option value="cycle">Cycle</option></select></div><div class="col-md-8"><label>Location</label><input class="form-control" asp-for="Location"/></div><div class="col-md-4"><label>Distance (km)</label><input class="form-control" asp-for="Distance"/></div><div class="col-12"><label>Description</label><textarea class="form-control" asp-for="Description"></textarea></div><div class="col-md-6"><label>Status</label><input class="form-control" asp-for="Status"/></div><div class="col-md-6"><label>Banner image</label><input class="form-control" asp-for="Banner" type="file" accept="image/*"/></div><div class="col-12"><button class="btn btn-race">Save event</button></div></form>
