@model JsonElement[]
@{Layout="_Layout";var eventId=(int)ViewBag.EventId;}<h1>Event enrolments</h1><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Record result</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.GetProperty("participant").GetProperty("firstName").GetString() @e.GetProperty("participant").GetProperty("lastName").GetString()</td><td>@e.GetProperty("category").GetProperty("categoryName").GetString()</td><td><span class="badge text-bg-success">@e.GetProperty("status").GetString()</span></td><td><form method="post" asp-action="RecordResult" class="d-flex gap-1"><input type="hidden" name="EnrollmentId" value="@e.GetProperty("enrollmentId").GetInt32()"/><input type="hidden" name="eventId" value="@eventId"/><input class="form-control form-control-sm" name="FinishTime" type="time" required/><input class="form-control form-control-sm" name="Position" type="number" min="1" placeholder="Position" required/><button class="btn btn-race btn-sm">Publish</button></form></td></tr>}</tbody></table>
