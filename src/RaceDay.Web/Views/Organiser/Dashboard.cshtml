@model JsonElement[]
@{Layout="_Layout";}<div class="d-flex justify-content-between"><div><h1>Organiser dashboard</h1><p>Your upcoming race calendar and activity.</p></div><a class="btn btn-race" asp-action="CreateEvent">Create event</a></div><div class="row g-3">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><div class="card p-3 h-100"><span class="badge text-bg-dark">@e.GetProperty("eventType").GetString()</span><h2 class="h4 mt-2">@e.GetProperty("eventName").GetString()</h2><p>@e.GetProperty("eventDate").GetString()<br/>@e.GetProperty("enrollmentCount").GetInt32() enrolments</p><a asp-action="Enrollments" asp-route-eventId="@e.GetProperty("eventId").GetInt32()">View entrants</a></div></div>}@if(!Model.Any()){<p>Create your first event to begin.</p>}</div>
