@model CategoryViewModel
@{Layout="_Layout";var categories=(JsonElement[])ViewBag.Categories;var eventId=(int)ViewBag.EventId;}<h1>Categories</h1><div class="row"><div class="col-md-7"><table class="table"><thead><tr><th>Name</th><th>Distance</th><th>Age</th><th>Fee</th></tr></thead><tbody>@foreach(var c in categories){<tr><td>@c.GetProperty("categoryName").GetString()</td><td>@c.GetProperty("distance").GetDecimal() km</td><td>@c.GetProperty("minAge").GetInt32()-@c.GetProperty("maxAge").GetInt32()</td><td>R @c.GetProperty("entryFee").GetDecimal()</td></tr>}</tbody></table></div><div class="col-md-5"><div class="card p-3"><h2 class="h4">Add category</h2><form method="post"><input asp-for="CategoryId" type="hidden"/><div class="mb-2"><input class="form-control" asp-for="CategoryName" placeholder="Category name"/></div><div class="mb-2"><input class="form-control" asp-for="Distance" placeholder="Distance"/></div><div class="row g-2"><div class="col"><input class="form-control" asp-for="MinAge" placeholder="Min age"/></div><div class="col"><input class="form-control" asp-for="MaxAge" placeholder="Max age"/></div></div><div class="my-2"><input class="form-control" asp-for="EntryFee" placeholder="Entry fee"/></div><button class="btn btn-race">Add category</button></form></div></div></div>
