@model JsonElement[]
@{Layout="_Layout";}<div class="d-flex justify-content-between"><h1>Manage events</h1><a class="btn btn-race" asp-action="CreateEvent">Create event</a></div><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Enrolments</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.GetProperty("eventName").GetString()</td><td>@e.GetProperty("eventDate").GetString()</td><td>@e.GetProperty("enrollmentCount").GetInt32()</td><td><a class="btn btn-sm btn-outline-dark" asp-action="EditEvent" asp-route-id="@e.GetProperty("eventId").GetInt32()">Edit</a> <a class="btn btn-sm btn-outline-dark" asp-action="Categories" asp-route-eventId="@e.GetProperty("eventId").GetInt32()">Categories</a><form class="d-inline" method="post" asp-action="DeleteEvent"><input type="hidden" name="id" value="@e.GetProperty("eventId").GetInt32()"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table>
