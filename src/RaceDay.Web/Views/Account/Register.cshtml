@model RegisterViewModel
@{Layout="_Layout";}<div class="auth-card wide"><h1>Join RaceDay</h1><form method="post"><div class="row g-2"><div class="col-md-6"><input class="form-control" asp-for="Username" placeholder="Username"/></div><div class="col-md-6"><input class="form-control" asp-for="Email" placeholder="Email"/></div><div class="col-md-6"><input class="form-control" asp-for="Password" placeholder="Password"/></div><div class="col-md-6"><select class="form-select" asp-for="Role"><option>Participant</option><option>Organiser</option></select></div><div class="col-md-6"><input class="form-control" asp-for="FirstName" placeholder="First name"/></div><div class="col-md-6"><input class="form-control" asp-for="LastName" placeholder="Last name"/></div><div class="col-md-6"><input class="form-control" asp-for="DateOfBirth" type="date"/></div><div class="col-md-6"><input class="form-control" asp-for="Gender" placeholder="Gender"/></div><div class="col-12"><input class="form-control" asp-for="EmergencyContact" placeholder="Emergency contact"/></div><div class="col-md-6"><input class="form-control" asp-for="OrganisationName" placeholder="Organisation name (organisers)"/></div><div class="col-md-6"><input class="form-control" asp-for="ContactName" placeholder="Contact name (organisers)"/></div><div class="col-12"><input class="form-control" asp-for="Phone" placeholder="Phone (organisers)"/></div></div><button class="btn btn-race mt-3">Create account</button><div class="text-danger" asp-validation-summary="All"></div></form></div>
